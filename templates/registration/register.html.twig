{#
  Template: registration/register.html.twig
  Purpose: Show a form for users to create an account.
  Extends: base.html.twig
    Variables expected:
      - registrationForm: form with the following properties:
          - email: text input
          - plainPassword: text input
          - agreeTerms: checkbox input
#}
{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

    {% block body %}
    <div class="registerDiv">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}
        <h1>Create an account</h1>
        <table id='registerTable'>
            <tr>
                <th>
                    Email
                </th>
                <td>
                    {{ form_row(registrationForm.email, {
                      label: ' '
                      }) }}
                </td>
            </tr>
            <tr>
                <th>
                    Password
                </th>
                <td>
                    {{ form_row(registrationForm.plainPassword, {
                       label: ' '
                       }) }}
                </td>
            </tr>
            <tr>
                <th colspan="2">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    Agree to the terms
                </th>
            </tr>
            <tr>
                <th>
                    <button type="submit" class="actionButton" id="registerButton">Register</button>
                </th>
                <td> </td>
            </tr>
        </table>
        {{ form_end(registrationForm) }}
    </div>
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('/styles/css/task.css') }}">
{% endblock %}
{% endblock %}
